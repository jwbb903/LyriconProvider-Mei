<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:description="@string/xposed_description"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LyricProvider">

        <activity
            android:name=".app.ui.SettingsActivity"
            android:exported="true"
            android:theme="@style/Theme.LyricProvider">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lyricon 插件元数据 -->
        <meta-data
            android:name="lyricon_module"
            android:value="true" />

        <meta-data
            android:name="lyricon_module_author"
            android:value="@string/lyricon_module_author" />

        <meta-data
            android:name="lyricon_module_description"
            android:value="@string/lyricon_module_description" />

        <meta-data
            android:name="lyricon_module_category"
            android:value="@string/lyricon_module_category" />

        <meta-data
            android:name="lyricon_module_tags"
            android:resource="@array/lyricon_module_tags" />

    </application>

</manifest>
